# 数据库（SQLite，本地运行）
DATABASE_URL="file:./data/app.db"

# ── AI 配置 ──
# 推荐通过「页面右下角 AI 助手抽屉」在界面配置模型与密钥（写入 data/ai-config.json，
# 运行时生效，优先于 .env）。以下 .env 变量仅作为首次部署的兜底默认值。

# DeepSeek（文本模型，用于 AI 变更提案；不支持视觉，户型识别走本地 CV）
DEEPSEEK_API_KEY=""

# 供应商 A：OpenAI 兼容（官方）
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o"
OPENAI_IMAGE_MODEL="gpt-image-1"

# 供应商 B：国内厂商（OpenAI 兼容协议，如通义千问 VL / 智谱 GLM-4V / 火山豆包视觉）
CUSTOM_BASE_URL=""
CUSTOM_API_KEY=""
CUSTOM_VISION_MODEL=""
CUSTOM_IMAGE_MODEL=""

# 其他厂商（可选）
GLM_API_KEY=""
MOONSHOT_API_KEY=""
DOUBAO_API_KEY=""

# 客户端分享链接签名密钥
CLIENT_ACCESS_SECRET=""
